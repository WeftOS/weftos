<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext only to Tailscale MagicDNS names, where WireGuard encrypts the hop (the CoS
     tailnet listener serves plain HTTP; ADR-118 3.3). Everything else stays HTTPS-only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ts.net</domain>
    </domain-config>
</network-security-config>
