pub fn rm_cmd(engine: Engine, name: &str) -> Vec<String> {
    match engine {
        Engine::Apple => vec!["delete".into(), "--force".into(), name.into()],
        _ => vec!["rm".into(), "-f".into(), name.into()],
    }
}

