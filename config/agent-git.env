# agent-git-flow settings for WeftOS (see ~/.claude/skills/agent-git-flow/docs/ADOPTING.md).
# Lanes land on the newest target-0.8.x; worktrees live on the external drive (owner rule).
AGF_TARGET_PATTERN='target-0.8.*'
AGF_WORKTREE_ROOT=/Volumes/ai-models/weftos-worktrees
AGF_BRANCH_PREFIX="wt/ feat/"
# Long-lived lines that branch pruning must never delete (0.8-metaharness holds v0.8.2).
AGF_PROTECTED_BRANCHES='master main develop development-* 0.8-metaharness release/* target-* staging production v[0-9]*'
AGF_PIN_RUST=1.95
AGF_DOCTOR="$HOME/.claude/skills/agent-git-flow/scripts/doctor.sh"
AGF_MIN_FREE_GB=100
AGF_MAIN_BRANCH=master
AGF_RELEASE_FF=1   # owner 2026-10-17: fast-forward master to each stable release
