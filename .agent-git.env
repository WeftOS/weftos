# DRAFT, pending the owner's decision (docs/plans/agent-git-flow-adoption-2026-11-08.md).
# Not adopted: nothing reads this file until it is merged into the main checkout, and while
# it exists it shadows config/agent-git.env, so it sources that file first and only adds to it.
. "$AGF_MAIN/config/agent-git.env"      # target pattern, protected branches, rust pin, master FF

AGF_REMOTE=origin                       # land.sh pushes the target to the PUBLIC origin; see plan, decision 2
AGF_WORKTREE_ROOT=/Volumes/ai-models/weftos-worktrees
AGF_MAX_WORKTREES=30                    # 23 lanes exist today; the default 8 makes `wt.sh new` refuse
AGF_BRANCH_PREFIX="wt/ feat/"

# T1, run by land.sh before the swap: the pre-build diff gate over what this lane adds.
# No cargo here: CI is green-of-record and the owner allows targeted tests only.
AGF_FAST_CHECK='case "$AGF_AFFECTED" in DOCS*) exit 0;; *) scripts/build.sh diff-gate --base "$AGF_BASE";; esac'
# AGF_FULL_GATE stays unset on purpose: no verify.sh runs of the whole workspace on the Mac.

# ADR-126 S2 worktree stores. Use these INSTEAD of `worktree-store.sh new` / `land`, never with them.
# Both read AGF_HOOK_BRANCH/AGF_HOOK_BASE; do not set WTS_SLUG (it would override the branch-derived slug).
AGF_HOOK_POST_NEW='scripts/worktree-store.sh store-create'
AGF_HOOK_POST_LAND='scripts/worktree-store.sh store-promote'
AGF_HOOKS_STRICT=0                      # a missing daemon or store warns; it never blocks git
