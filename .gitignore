.env-keys.json
# Documented Vite build-time template files (no secrets) — keep tracked.
!clawft-ui/.env
!clawft-ui/.env.mock
crates/clawft-wasm/www/pkg/

# WEFT-408: local/CI duration artefact from scripts/build.sh test-browser
# (committed baseline lives in scripts/bench/browser-test-duration-baseline.json).
browser-test-duration.json
bench-results.json

# process-compose runtime (yaml + compose/*.yaml stay tracked)
.grok/compose/logs/
.grok/compose/*.jsonl
.grok/compose/process-compose.log
.grok/compose/weaver-note.json

# WeftOS runtime state
weave.toml
.weftos/
gui/node_modules/
gui/dist/
clawft-ui/node_modules/
clawft-ui/dist/
